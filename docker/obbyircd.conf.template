/* ObbyIRCd configuration template
 * Rendered at first container start by docker-entrypoint.sh: every
 * ${...} placeholder is substituted via envsubst.  Do not edit this
 * file inside a running container -- edit conf/obbyircd.conf directly
 * or bake your changes into a fork of this template.
 */

me {
    name "${SERVER_NAME}";
    info "ObbyIRCd";
    sid "001";
};

admin {
    "${ADMIN_EMAIL}";
    "ObbyIRCd Administrator";
    "${NETWORK_NAME} Network";
};

class clients {
    pingfreq 90;
    maxclients 1000;
    sendq 200k;
    /* 8k upstream default is too tight for WebRTC SDP + metadata-2 batches;
     * modern clients flood out during voice negotiation. 32k is the parser's
     * hard cap. */
    recvq 30k;
};

class servers {
    pingfreq 60;
    maxclients 10;
    sendq 20M;
    connfreq 100;
};

allow {
    mask *;
    class clients;
    maxperip 5;
};

listen {
    ip *;
    port ${SSL_PORT};
    options { tls; };
};

oper ${OPER_NAME} {
    class clients;
    mask ${OPER_MASK};
    password "${OPER_PASSWORD}";
    operclass netadmin;
    swhois "is a Network Administrator";
    vhost netadmin.${SERVER_NAME};
};

include "modules.default.conf";
include "operclass.default.conf";
include "snomasks.default.conf";
include "help/help.conf";
include "badwords.conf";
include "spamfilter.conf";
include "custom-modules.conf";

loadmodule "cloak_sha256";

/* WebSocket listener (always emitted -- terminate TLS at the
 * reverse proxy in production). */
${WS_CONFIG}

/* Add a filehosts { host '<url>'; } block here to enable client uploads. */

/* Invite-link base URL: the obbyworld `invitation` module emits the
 * machine-readable INVITELINK reply with this prefix + the share-id, so
 * the panel can render a clickable link instead of just a bare token.
 * Set INVITE_BASE_URL (e.g. 'https://invite.example.com:8661/i/'); when
 * unset, the line below is replaced with an empty string and the reply
 * still works but only ships the bare id. */
${INVITE_CONFIG}

/* Invite-page HTTP listener: served by the in-tree webserver via
 * `options { invite-page; }`. Renders a join-the-network splash with
 * connect details when someone opens the INVITELINK URL in a browser.
 * Set INVITE_PAGE_PORT (default unset = no listener). Put a reverse
 * proxy with TLS in front of it in production. */
${INVITE_PAGE_CONFIG}

/* Optional JSON-RPC (set RPC_PASSWORD). */
${RPC_CONFIG}

/* Optional external TURN service (set VOICE_TURN_EXTERNAL_URLS). */
${VOICE_TURN_CONFIG}

/* Optional web push through obby-api (set WEBPUSH_BACKEND_URL and WEBPUSH_BACKEND_KEY). */
${WEBPUSH_CONFIG}

set {
    kline-address "${ADMIN_EMAIL}";
    modes-on-connect "+iwx";
    modes-on-oper "+xwgs";
    oper-auto-join "#opers";
    options {
        hide-ulines;
        show-connect-info;
    };
    maxchannelsperuser 20;
    default-server "${SERVER_NAME}";
    network-name "${NETWORK_NAME}";
    help-channel "#help";
    hiddenhost-prefix "hidden";
    prefix-quit "Quit";

    tls {
        certificate "${TLS_DIR}/server.cert.pem";
        key "${TLS_DIR}/server.key.pem";
    };

    cloak-keys {
        "${CLOAK_KEY1}";
        "${CLOAK_KEY2}";
        "${CLOAK_KEY3}";
    };

    default-bantime 30d;
    modef-default-unsettime 60;

    modes-on-join "+nH 1000:1d";
    history {
        channel {
            playback-on-join { lines 1000; time 1d; }
            max-storage-per-channel {
                registered { lines 5000; time 31d; }
                unregistered { lines 1000; time 7d; }
            }
        }
    };
};

except ban {
    mask { ip { 127.0.0.1; ::1; 172.16.0.0/12; 10.0.0.0/8; 192.168.0.0/16; fc00::/7; } }
    type { connect-flood; maxperip; }
};

account-registration {
    min-name-length 3;
    max-name-length 20;
    min-password-length 8;
    max-password-length 200;
    require-email yes;
    require-terms-acceptance no;
    allow-username-changes yes;
    allow-password-changes yes;
    allow-email-changes yes;
};
