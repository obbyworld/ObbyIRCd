# major edit from fez - to compile objects individually...

CC = "==== DO NOT RUN MAKE FROM THIS DIRECTORY ===="

INCLUDES = ../include/channel.h \
	../include/common.h ../include/config.h ../include/dbuf.h \
	../include/dynconf.h ../include/fdlist.h ../include/h.h \
	../include/ircsprintf.h \
	../include/license.h \
	../include/modules.h ../include/modversion.h ../include/msg.h \
	../include/numeric.h ../include/dns.h \
	../include/resource.h ../include/setup.h \
	../include/struct.h ../include/sys.h \
	../include/types.h \
	../include/version.h ../include/whowas.h

MODULES= \
	cloak_md5.so cloak_sha256.so cloak_none.so \
	sethost.so chghost.so chgident.so setname.so \
	setident.so sdesc.so svsmode.so swhois.so\
	svsmotd.so svsnline.so who_old.so whox.so mkpasswd.so \
	away.so svsnoop.so svsnick.so svso.so svslogin.so \
	chgname.so kill.so \
	lag.so message.so oper.so pingpong.so \
	quit.so sendumode.so sqline.so sreply.so \
	tsctl.so unsqline.so whois.so \
	tkl.so vhost.so cycle.so svsjoin.so svspart.so \
	svswatch.so svssilence.so sendsno.so svssno.so \
	sajoin.so sapart.so samode.so kick.so topic.so \
	invite.so list.so time.so svskill.so sjoin.so \
	pass.so userhost.so ison.so silence.so knock.so \
	umode2.so squit.so protoctl.so addomotd.so \
	admin.so globops.so locops.so \
	trace.so netinfo.so links.so help.so rules.so \
	close.so map.so eos.so server.so stats.so \
	dccdeny.so whowas.so \
	connect.so dccallow.so userip.so nick.so user.so \
	mode.so watch.so part.so join.so motd.so opermotd.so \
	botmotd.so lusers.so names.so svsnolag.so addmotd.so \
	svslusers.so starttls.so webredir.so cap.so \
	sasl.so md.so certfp.so \
	connect-flood.so max-unknown-connections-per-ip.so \
	webirc.so webserver.so websocket_common.so websocket.so \
	blacklist.so jointhrottle.so \
	antirandom.so hideserver.so jumpserver.so \
	ircops.so staff.so nocodes.so \
	charsys.so antimixedutf8.so authprompt.so sinfo.so \
	reputation.so connthrottle.so history_backend_mem.so \
	history_backend_null.so tkldb.so channeldb.so whowasdb.so \
	restrict-commands.so rmtkl.so require-module.so \
	account-notify.so \
	message-tags.so batch.so multiline.so \
	account-tag.so labeled-response.so link-security.so \
	message-ids.so plaintext-policy.so server-time.so sts.so \
	echo-message.so userip-tag.so userhost-tag.so geoip-tag.so \
	bot-tag.so reply-tag.so json-log-tag.so e2ee-tag.so \
	typing-indicator.so channel-context.so \
	ident_lookup.so history.so chathistory.so \
	targetfloodprot.so clienttagdeny.so watch-backend.so \
	monitor.so slog.so tls_cipher.so operinfo.so creationtime.so portinfo.so \
	unreal_server_compat.so \
	extended-monitor.so geoip_csv.so \
	geoip_base.so extjwt.so tline.so \
	standard-replies.so issued-by-tag.so \
	real-quit-reason.so \
	spamreport.so crule.so \
	central-api.so central-blocklist.so \
	no-implicit-names.so maxperip.so utf8functions.so utf8only.so \
	isupport.so extended-isupport.so extended-isupport-test.so \
	$(GEOIP_CLASSIC_OBJECTS) \
	geoip_mmdb.so \
	persistence.so \
	account-registration.so \
	guest-nicks.so \
	obbyscript.so \
	obbypy.so \
	pushbot.so \
	metadata.so \
	metadata-db.so \
	filehost.so \
	relaymsg.so \
	invite-page.so \
	invitation.so \
	authtoken.so \
	smtp.so \
	emoji.so \
	account-recovery.so \
	read-marker.so \
	pm_history.so \
	webpush.so \
	cmdslist.so \
	named-modes.so \
	member-roles.so \
	memo.so \
	voice-channels.so \
	sentinel.so \
	redact.so \
	react.so \
	channel-rename.so \
	draft-ai-tools.so

MODULEFLAGS=@MODULEFLAGS@
RM=@RM@

.SUFFIXES:
.SUFFIXES: .c .h .so

all: build

build: $(MODULES)
	cd chanmodes; $(MAKE) all
	cd usermodes; $(MAKE) all
	cd extbans; $(MAKE) all
	cd rpc; $(MAKE) all
	cd third; $(MAKE) all

clean:
	$(RM) -f *.o *.so *~ core
	cd chanmodes; $(MAKE) clean
	cd usermodes; $(MAKE) clean
	cd extbans; $(MAKE) clean
	cd rpc; $(MAKE) clean
	cd third; $(MAKE) clean

# Generic *.so rule:
%.so: %.c $(INCLUDES)
	$(CC) $(CFLAGS) $(MODULEFLAGS) -DDYNAMIC_LINKING \
		-o $@ $<

# geoip_classic requires extra library
geoip_classic.so: geoip_classic.c $(INCLUDES)
	$(CC) $(CFLAGS) $(MODULEFLAGS) $(GEOIP_CLASSIC_CFLAGS) -DDYNAMIC_LINKING \
		-o geoip_classic.so geoip_classic.c @LDFLAGS_PRIVATELIBS@ $(GEOIP_CLASSIC_LIBS)

# geoip_mmdb uses shipped mmdb.c
geoip_mmdb.so: geoip_mmdb.c $(INCLUDES)
	$(CC) $(CFLAGS) $(MODULEFLAGS) -DDYNAMIC_LINKING \
		-o geoip_mmdb.so geoip_mmdb.c mmdb.c

# account-registration needs sqlite3 and libcrypt (for bcrypt /
# crypt-sha256 / crypt-sha512 verifiers used on migrated accounts).
account-registration.so: account-registration.c $(INCLUDES)
	$(CC) $(CFLAGS) $(MODULEFLAGS) -DDYNAMIC_LINKING \
		-o account-registration.so account-registration.c -lsqlite3 -lcrypt

# account-recovery talks to the same sqlite db as account-registration
account-recovery.so: account-recovery.c $(INCLUDES)
	$(CC) $(CFLAGS) $(MODULEFLAGS) -DDYNAMIC_LINKING \
		-o account-recovery.so account-recovery.c -lsqlite3

# memo lives in the same obsidian.db as accounts
memo.so: memo.c $(INCLUDES)
	$(CC) $(CFLAGS) $(MODULEFLAGS) -DDYNAMIC_LINKING \
		-o memo.so memo.c -lsqlite3

# invitation opens its own SQLite handle on obsidian.db so it doesn't
# need a hard link-time dep on account-registration.so's symbols.
invitation.so: invitation.c $(INCLUDES)
	$(CC) $(CFLAGS) $(MODULEFLAGS) -DDYNAMIC_LINKING \
		-o invitation.so invitation.c -lsqlite3

# invite-page reads the invitations table for its /i/<share-id> route
# directly via its own sqlite handle (same DB file, separate handle).
invite-page.so: invite-page.c $(INCLUDES)
	$(CC) $(CFLAGS) $(MODULEFLAGS) -DDYNAMIC_LINKING \
		-o invite-page.so invite-page.c -lsqlite3

# read-marker also lives in obsidian.db
read-marker.so: read-marker.c $(INCLUDES)
	$(CC) $(CFLAGS) $(MODULEFLAGS) -DDYNAMIC_LINKING \
		-o read-marker.so read-marker.c -lsqlite3

# pm_history persists PMs between account-holders so CHATHISTORY can
# replay them on reconnect (Ergo-style).  Its own sqlite handle on
# obsidian.db, no link-time dep on account-registration.so.
pm_history.so: pm_history.c $(INCLUDES)
	$(CC) $(CFLAGS) $(MODULEFLAGS) -DDYNAMIC_LINKING \
		-o pm_history.so pm_history.c -lsqlite3

# webpush stores per-account Web Push subscriptions in obsidian.db and
# POSTs notification jobs to the hosted-backend (which owns the VAPID
# private key + does the RFC 8291 encryption).
webpush.so: webpush.c $(INCLUDES)
	$(CC) $(CFLAGS) $(MODULEFLAGS) -DDYNAMIC_LINKING \
		-o webpush.so webpush.c -lsqlite3

# voice-channels needs jansson for the Unix-socket bridge JSON.
# Use @JANSSON_LIBS@ from configure -- system jansson via pkg-config
# if found, else the bundled extras/jansson copy at $(PRIVATELIBDIR).
voice-channels.so: voice-channels.c $(INCLUDES)
	$(CC) $(CFLAGS) $(MODULEFLAGS) -DDYNAMIC_LINKING \
		-o voice-channels.so voice-channels.c @JANSSON_LIBS@

# sentinel: in-process behavioural detector. Uses jansson for the
# training-side socket emit; same dep as voice-channels.
sentinel.so: sentinel.c $(INCLUDES)
	$(CC) $(CFLAGS) $(MODULEFLAGS) -DDYNAMIC_LINKING \
		-o sentinel.so sentinel.c @JANSSON_LIBS@

# obbyscript embeds Duktape and needs -lm
# obbyscript bundles the vendored duktape amalgamation, which uses dynamic
# format strings by design (-Wformat-nonliteral) and can't be patched without
# diverging from upstream.  Demote warnings to non-fatal for this module so the
# hardened (-Werror) build still passes; -Werror stays in force everywhere else.
obbyscript.so: obbyscript.c duktape.c ../include/duktape.h ../include/duk_config.h $(INCLUDES)
	$(CC) $(CFLAGS) -Wno-error $(MODULEFLAGS) -DDYNAMIC_LINKING \
		-o obbyscript.so obbyscript.c -lm

# obbypy embeds CPython via libpython3.  Use python3-embed pkg-config so
# the resulting .so links libpython properly (Py_Initialize requires
# the embedding-flavour linkage).  Falls back to python3 pkg-config on
# distros that don't ship the -embed pc file.
PYTHON_EMBED_CFLAGS := $(shell pkg-config --cflags python3-embed 2>/dev/null || pkg-config --cflags python3)
PYTHON_EMBED_LIBS   := $(shell pkg-config --libs   python3-embed 2>/dev/null || pkg-config --libs   python3)
# obbypy embeds CPython; the Python C-API forces idioms the hardened build
# rejects (METH_KEYWORDS function-pointer casts, pyconfig.h re-#defining
# HAVE_* macros).  Demote warnings to non-fatal for this module only.
obbypy.so: obbypy.c $(INCLUDES)
	$(CC) $(CFLAGS) -Wno-error $(PYTHON_EMBED_CFLAGS) $(MODULEFLAGS) -DDYNAMIC_LINKING \
		-o obbypy.so obbypy.c $(PYTHON_EMBED_LIBS)

# pushbot keeps its own SQLite store (separate from obsidian.db).
pushbot.so: pushbot.c $(INCLUDES)
	$(CC) $(CFLAGS) $(MODULEFLAGS) -DDYNAMIC_LINKING \
		-o pushbot.so pushbot.c -lsqlite3
